&ACCESS RVP
&REL 3
&COMMENT Force Sensor Gravity Calibration - Diversified Poses
DEF FT_Calibration ( )
  ;FOLD INI;%{PE}
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV, 0)
  ;ENDFOLD (BASISTECH INI)

  ;FOLD SPTP HOME Vel=100 % DEFAULT ;%{PE}
  ;FOLD Parameters ;%{h}
  ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=HOME; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=DEFAULT; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
  ;ENDFOLD
  SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
  ;ENDFOLD

  ; ---------- 1. Frames and Dynamics Configuration ----------
  $ACT_BASE = 1
  $BASE = BASE_DATA[1]
  $ACT_TOOL = 1
  $TOOL = TOOL_DATA[1]
  $IPO_MODE = #BASE

  $VEL.CP = 0.10
  $ACC.CP = 0.3
  $VEL.ORI1 = 20
  $VEL.ORI2 = 20
  $ACC.ORI1 = 40
  $ACC.ORI2 = 40
  $ORI_TYPE = #VAR

  data_collection = FALSE

  ; Reference position (Subsequent XYZ coordinates are trimmed within +/-20 mm)
  ; BASE: X1120 Y240 Z-1200 A-170 B0 C0

  ; ---------- 2. PTP to Reference Pose (Lock Axis Configuration) ----------
  PTP {X 1120.0, Y 240.0, Z -1200.0, A -170.0, B 0.0, C 0.0}
  WAIT SEC 0.2

  ; ---------- 3. Start RSI Communication ----------
  RSI_Control(TRUE)

  ; ---------- 4. 16 Dispersed Poses (A fixed at -170 deg, B/C spanning +/-50 deg) ----------

  ; Pose 1: Reference (1st iteration)
  LIN {X 1120.0, Y 240.0, Z -1200.0, A -170.0, B 0.0, C 0.0}
  RECORD_SAMPLE()

  ; Pose 2: B+60
  LIN {X 1135.0, Y 240.0, Z -1200.0, A -170.0, B 50.0, C 0.0}
  RECORD_SAMPLE()

  ; Pose 3: B+60 / C+60
  LIN {X 1130.0, Y 250.0, Z -1190.0, A -170.0, B 50.0, C 60.0}
  RECORD_SAMPLE()

  ; Pose 4: C+60
  LIN {X 1120.0, Y 255.0, Z -1200.0, A -170.0, B 0.0, C 60.0}
  RECORD_SAMPLE()

  ; Pose 5: B-60 / C+60
  LIN {X 1110.0, Y 250.0, Z -1190.0, A -170.0, B -50.0, C 60.0}
  RECORD_SAMPLE()

  ; Pose 6: B-60
  LIN {X 1105.0, Y 240.0, Z -1200.0, A -170.0, B -50.0, C 0.0}
  RECORD_SAMPLE()

  ; Pose 7: B-60 / C-60
  LIN {X 1110.0, Y 230.0, Z -1210.0, A -170.0, B -50.0, C -60.0}
  RECORD_SAMPLE()

  ; Pose 8: C-60
  LIN {X 1120.0, Y 225.0, Z -1200.0, A -170.0, B 0.0, C -60.0}
  RECORD_SAMPLE()

  ; Pose 9: B+60 / C-60
  LIN {X 1130.0, Y 230.0, Z -1210.0, A -170.0, B 50.0, C -60.0}
  RECORD_SAMPLE()

  ; Pose 10: Reference (2nd iteration, drift check)
  LIN {X 1120.0, Y 240.0, Z -1200.0, A -170.0, B 0.0, C 0.0}
  RECORD_SAMPLE()

  ; Pose 11: B+45 / C+45
  LIN {X 1130.0, Y 250.0, Z -1195.0, A -170.0, B 45.0, C 45.0}
  RECORD_SAMPLE()

  ; Pose 12: B-45 / C+45
  LIN {X 1110.0, Y 250.0, Z -1195.0, A -170.0, B -45.0, C 45.0}
  RECORD_SAMPLE()

  ; Pose 13: B-45 / C-45
  LIN {X 1110.0, Y 230.0, Z -1205.0, A -170.0, B -45.0, C -45.0}
  RECORD_SAMPLE()

  ; Pose 14: B+45 / C-45
  LIN {X 1130.0, Y 230.0, Z -1205.0, A -170.0, B 45.0, C -45.0}
  RECORD_SAMPLE()

  ; Pose 15: Intermediate angle supplement B-30 / C+30
  LIN {X 1115.0, Y 245.0, Z -1195.0, A -170.0, B -30.0, C 30.0}
  RECORD_SAMPLE()

  ; Pose 16: Reference (3rd iteration, hysteresis check)
  LIN {X 1120.0, Y 240.0, Z -1200.0, A -170.0, B 0.0, C 0.0}
  RECORD_SAMPLE()

  ; ---------- 5. Stop RSI and Return HOME ----------
  RSI_Control(FALSE)

  PTP {X 1120.0, Y 240.0, Z -1200.0, A -170.0, B 0.0, C 0.0}

  ;FOLD SPTP HOME Vel=100 % DEFAULT ;%{PE}
  ;FOLD Parameters ;%{h}
  ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=HOME; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=DEFAULT; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
  ;ENDFOLD
  SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
  ;ENDFOLD

END

; ---------- Sample Acquisition: Dwell 0.5s -> TRUE 1.0s -> FALSE ----------
; Allow sufficient settling time after large angular moves; sampling window extended to 1.0s to reduce mean noise
DEF RECORD_SAMPLE ( )
  WAIT SEC 0.5
  data_collection = TRUE
  WAIT SEC 1.0
  data_collection = FALSE
  WAIT SEC 0.2
END